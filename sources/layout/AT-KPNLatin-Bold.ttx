      <map code="0x25c6" name="uni25C6"/><!-- BLACK DIAMOND -->
      <map code="0x25ca" name="lozenge"/><!-- LOZENGE -->
      <map code="0x25cc" name="uni25CC"/><!-- DOTTED CIRCLE -->
      <map code="0xfb00" name="f_f"/><!-- LATIN SMALL LIGATURE FF -->
      <map code="0xfb01" name="fi"/><!-- LATIN SMALL LIGATURE FI -->
      <map code="0xfb02" name="fl"/><!-- LATIN SMALL LIGATURE FL -->
